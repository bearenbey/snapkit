#!/bin/bash
set -eu

CHROMIUM_DIR="$SNAP/usr/lib/ungoogled-chromium"

export CHROME_VERSION_EXTRA="snap"

FLAGS=()

# Chromium blocks on startup when no keyring is reachable.
if [ -z "${GNOME_KEYRING_CONTROL:-}" ] && [ -z "${KDE_FULL_SESSION:-}" ] \
   && ! { command -v busctl >/dev/null 2>&1 \
          && busctl --user status org.freedesktop.secrets >/dev/null 2>&1; }; then
  FLAGS+=("--password-store=basic")
fi

# Ozone/Wayland when the session is Wayland and the user has not overridden it.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  FLAGS+=("--ozone-platform-hint=auto")
fi

# User-supplied persistent flags, one per line, comments allowed.
FLAGS_FILE="$SNAP_USER_COMMON/chromium-flags.conf"
if [ -r "$FLAGS_FILE" ]; then
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    FLAGS+=("$line")
  done < "$FLAGS_FILE"
fi

# SNAP_USER_COMMON, so the profile survives a refresh.
exec "$CHROMIUM_DIR/chrome" \
  --user-data-dir="$SNAP_USER_COMMON/chromium" \
  "${FLAGS[@]}" "$@"
