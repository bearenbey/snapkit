#!/bin/sh
# Wrapper for the bundled mpv: absolute paths, config dir, GPU drivers.
set -eu

# yt-dlp: a user copy in $SNAP_USER_DATA/bin beats the bundled one.
PATH="$SNAP_USER_DATA/bin:$PATH"
export PATH

# libpulse's DT_RUNPATH points into the base snap, so put ours ahead of it.
for d in "$SNAP"/usr/lib/*/pulseaudio; do
	[ -d "$d" ] || continue
	LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$d"
done
export LD_LIBRARY_PATH

# snapd moves XDG_RUNTIME_DIR, so name the real socket one level up.
if [ -z "${PULSE_SERVER:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] &&
   [ ! -S "$XDG_RUNTIME_DIR/pulse/native" ] &&
   [ -S "$XDG_RUNTIME_DIR/../pulse/native" ]; then
	export PULSE_SERVER="unix:$XDG_RUNTIME_DIR/../pulse/native"
fi

# libasound compiles in /usr/share/alsa/alsa.conf, which core24 lacks.
if [ -f "$SNAP/usr/share/alsa/alsa.conf" ]; then
	export ALSA_CONFIG_PATH="$SNAP/usr/share/alsa/alsa.conf"
fi

# Fontconfig: list both $SNAP's fonts and the host's, and take what exists.
fc_conf="$SNAP_USER_DATA/.config/mpv-snap-fonts.conf"
if ! grep -qF "<dir>$SNAP/usr/share/fonts</dir>" "$fc_conf" 2>/dev/null; then
	if mkdir -p "${fc_conf%/*}" 2>/dev/null; then
		cat > "$fc_conf" <<EOF || true
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <dir>$SNAP/usr/share/fonts</dir>
  <dir>/usr/share/fonts</dir>
  <dir>/usr/local/share/fonts</dir>
  <dir prefix="xdg">fonts</dir>
  <cachedir>$SNAP_USER_DATA/.cache/fontconfig</cachedir>
  <include ignore_missing="yes">$SNAP/etc/fonts/conf.d</include>
</fontconfig>
EOF
	fi
fi
if [ -s "$fc_conf" ]; then
	export FONTCONFIG_FILE="$fc_conf"
	export FONTCONFIG_PATH="$SNAP/etc/fonts"
fi

# Config: readable ~/.config/mpv is the only sign dot-config-mpv is connected.
if [ -z "${MPV_HOME:-}" ] && [ -n "${SNAP_REAL_HOME:-}" ] &&
   [ -r "$SNAP_REAL_HOME/.config/mpv" ] 2>/dev/null; then
	export MPV_HOME="$SNAP_REAL_HOME/.config/mpv"
fi

# Use mesa-2604's wrapper when connected, and run mpv directly when not.
gpu_wrapper="$SNAP/gpu-2604/bin/gpu-2604-provider-wrapper"
if [ -x "$gpu_wrapper" ]; then
	exec "$gpu_wrapper" "$SNAP/usr/bin/mpv" "$@"
fi

exec "$SNAP/usr/bin/mpv" "$@"
